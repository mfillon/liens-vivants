{
  "name": "liens-vivants-backend",
  "version": "1.0.0",
  "description": "Express REST API for Liens Vivants",
  "license": "GPL-3.0-only",
  "main": "dist/server.js",
  "scripts": {
    "start": "node --experimental-sqlite dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_OPTIONS='--experimental-sqlite' tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "*",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.4",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
